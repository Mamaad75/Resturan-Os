  tenantId          String   @db.Uuid
  sku               String?  @db.VarChar(64)
  name              String   @db.VarChar(140)
  unit              String   @default("UNIT") @db.VarChar(24)
  unitCost          Int      @default(0)
  lowStockThreshold Decimal  @default(0) @db.Decimal(14, 3)
  trackStock        Boolean  @default(true)
  isActive          Boolean  @default(true)
