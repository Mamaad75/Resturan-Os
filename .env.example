# ---------------------------------------------------------------------------
# Restaurant OS - environment template
# Copy to `.env` (repo root) and adjust. NEVER commit a filled-in .env file.
# ---------------------------------------------------------------------------

NODE_ENV=development
TZ=Asia/Tehran

# --- Database --------------------------------------------------------------
# Matches the `postgres` service in docker-compose.yml.
DATABASE_URL=postgresql://restaurant:restaurant@localhost:5432/restaurant_os?schema=public
# Separate database used by `pnpm test:e2e`; it is migrated and truncated freely.
TEST_DATABASE_URL=postgresql://restaurant:restaurant@localhost:5432/restaurant_os_test?schema=public

# --- Redis (optional) ------------------------------------------------------
# Used for the socket.io adapter and response caching when multiple API
# instances run behind a load balancer. The app runs fine without it.
REDIS_URL=redis://localhost:6379

# --- URLs ------------------------------------------------------------------
API_PORT=4000
API_PREFIX=api
# Public origin of the API, used in Swagger and QR target construction.
API_URL=http://localhost:4000
# Public origin of the customer/admin frontend. QR codes point here.
APP_URL=http://localhost:3000
# Comma-separated list of origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:3000

# --- Authentication --------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL=900
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECRET=replace-me-with-another-long-random-string
# Leave empty for localhost; set to your apex domain in production.
COOKIE_DOMAIN=
# Must be `true` in production so cookies are only sent over HTTPS.
COOKIE_SECURE=false

# --- Rate limiting ---------------------------------------------------------
THROTTLE_TTL=60
THROTTLE_LIMIT=120
# Stricter bucket applied to /auth/login and public order submission.
THROTTLE_AUTH_LIMIT=10

# --- SMS provider ----------------------------------------------------------
# `console` writes messages to the log (development default).
# `kavenegar` and `sms_ir` are real Iranian providers behind the same adapter.
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER=
SMS_MAX_ATTEMPTS=4

# --- Payment provider ------------------------------------------------------
# `manual` records cash/card payments taken at the counter (development default).
# `zarinpal` is a real Iranian gateway behind the same adapter.
PAYMENT_PROVIDER=manual
PAYMENT_API_KEY=
PAYMENT_CALLBACK_URL=http://localhost:3000/payment/callback

# --- Object storage --------------------------------------------------------
# `local` writes to STORAGE_LOCAL_DIR and serves from STORAGE_PUBLIC_URL.
# `s3` targets any S3-compatible endpoint (MinIO, Arvan, Liara).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage/uploads
STORAGE_PUBLIC_URL=http://localhost:4000/uploads
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=restaurant-os
STORAGE_REGION=us-east-1

# --- Frontend (Next.js) ----------------------------------------------------
# Exposed to the browser; must be reachable from the client device.
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_WS_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
